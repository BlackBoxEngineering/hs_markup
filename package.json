{
  "name": "hs_markup",
  "version": "0.1.1",
  "description": "Lightweight React rich-text editor. Stores content as plain-text markup, not HTML.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlackBoxEngineering/hs_markup.git"
  },
  "sideEffects": false,
  "keywords": [
    "markup",
    "editor",
    "react",
    "rich-text",
    "wysiwyg"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/react": "^18",
    "vitest": "^3",
    "jsdom": "^25"
  }
}
